# Baza
POSTGRES_USER=kk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=klimakompas
DATABASE_URL=postgresql+psycopg://kk:change-me@localhost:5432/klimakompas

# HTTP identitet: naziv projekta i URL repozitorija
KK_USER_AGENT="KlimaKompasHR/0.1 (+https://github.com/dlukas99/klimakompas-hr)"

# LLM (OpenAI-kompatibilno; zadano lokalni Ollama)
# TODO(verify): oznaku modela provjeriti u Ollama knjižnici
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:4b
LLM_API_KEY=ollama

# Copernicus Climate Data Store (ECDE)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Opcionalno
DGU_AUTHKEY=
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
TZ=Europe/Zagreb
